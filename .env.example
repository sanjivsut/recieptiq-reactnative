# Base URL of the deployed ReceiptIQ web app (Next.js on Vercel). Used as the
# base for ${EXPO_PUBLIC_API_BASE_URL}/api/ocr and /api/prices.
#
# EXPO_PUBLIC_* vars are baked into the client bundle by design (Expo's
# equivalent of Next's NEXT_PUBLIC_*). That's fine here: this is just a base
# URL, not a secret — the Gemini API key stays server-side in the web app and
# is never present in this mobile bundle.
#
# Leave unset to run with AI scanning disabled: the sample picker and offline
# price matching still work fully; real-photo scans show a calm
# "AI scanning isn't set up" message instead of crashing.
EXPO_PUBLIC_API_BASE_URL=https://receiptiq.vercel.app
